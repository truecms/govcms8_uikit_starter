{
    "name": "govcms/govcms8_uikit_starter",
    "description": "Provides uikit starter theme to govCMS8",
    "type": "drupal-theme",
    "license": "GPL-2.0+",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "drupal/coder": "^8.3",
        "phpmd/phpmd": "^2.15",
        "rector/rector": "^1.2",
        "squizlabs/php_codesniffer": "^3.9",
        "phpcompatibility/php-compatibility": "^9.3",
        "friendsoftwig/twigcs": "^6.5",
        "vincentlanglet/twig-cs-fixer": "^3.10"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@lint:phpcs",
            "@lint:phpmd",
            "@lint:rector",
            "@lint:twigcs",
            "@lint:twigcs-fixer"
        ],
        "lint:phpcs": "phpcs",
        "lint:phpmd": "phpmd . text phpmd.xml",
        "lint:rector": "rector --clear-cache --dry-run",
        "lint:twigcs": "twigcs --config=.twig_cs.php templates",
        "lint:twigcs-fixer": "twig-cs-fixer lint templates"
    }
}
