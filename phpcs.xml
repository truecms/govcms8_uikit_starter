<?xml version="1.0"?>
<ruleset name="theme">
    <description>PHPCS for theme only (Drupal + PHPCompatibility).</description>

    <file>./</file>

    <rule ref="Drupal"/>
    <rule ref="DrupalPractice"/>
    <rule ref="PHPCompatibility"/>

    <arg name="extensions" value="inc,info,install,module,php,profile,theme,engine"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="50"/>

    <!-- Target platform PHP version. -->
    <config name="testVersion" value="8.4"/>

    <!-- Exclusions (do not lint assets or vendor). -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/styleguide/*</exclude-pattern>
    <exclude-pattern>*/GovCMS-kss-template/*</exclude-pattern>
    <exclude-pattern>*/css/*</exclude-pattern>
    <exclude-pattern>*/js/*</exclude-pattern>
    <exclude-pattern>*/*.min.*</exclude-pattern>
</ruleset>

